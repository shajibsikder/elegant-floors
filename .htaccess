# Apache Clean URL Rules for woodflooringhouse.com
# Removes index.html from all URLs automatically
DirectoryIndex index.html
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Redirect /services/name/index.html to /services/name/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)/index\.html [NC]
  RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]
</IfModule>
